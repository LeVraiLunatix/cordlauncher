{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CordLauncher",
  "version": "../package.json",
  "identifier": "app.cordsuite.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CordLauncher",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#07060c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lunatix",
    "copyright": "© 2026 Lunatix",
    "category": "Utility",
    "shortDescription": "Installe et met à jour les apps de la suite Cord",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
