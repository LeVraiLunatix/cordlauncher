  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Hub d'installation Windows de la suite Cord.",
  "scripts": {
    "account:dev": "node account-service/server.mjs",
    "account:test": "node --test account-service/server.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
